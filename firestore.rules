rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    match /users/{uid}/gameData/saveData {
      allow read, delete: if owner(uid);
      // Personal save state is untrusted and must never drive official scores.
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['playerHP','playTime','gameProgress','courseProgress','characters','lastSaved','version'])
        && request.resource.data.keys().hasAll(['playerHP','playTime','gameProgress','courseProgress','characters','lastSaved','version'])
        && request.resource.data.playerHP is number && request.resource.data.playerHP >= 0 && request.resource.data.playerHP <= 100000
        && request.resource.data.playTime is number && request.resource.data.playTime >= 0
        && request.resource.data.gameProgress is number && request.resource.data.gameProgress >= 0
        && request.resource.data.courseProgress is map
        && request.resource.data.characters is list && request.resource.data.characters.size() <= 5
        && request.resource.data.lastSaved is string && request.resource.data.lastSaved.size() <= 40
        && request.resource.data.version == '1.0';
    }
  }
}
