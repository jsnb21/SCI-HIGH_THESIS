{
  "rules": {
    
    "roles": {
      "professors": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "students": {
      ".indexOn": ["studentId"],
      ".read": "auth != null",
      ".write": "auth != null",
      "$studentKey": {
        "studentId": { ".validate": "newData.isString() && newData.val().length > 0" },
        "fullName": { ".validate": "newData.isString()" },
        "academicInfo": { ".validate": "newData.hasChildren()" },
        "accountStatus": { ".validate": "newData.hasChildren(['isActive', 'createdAt'])" },
        "gameData": { ".validate": "newData.hasChildren()" }
      }
    },

    "customQuizzes": {
      ".read": "auth != null",
      "$profUid": {
        ".read": "auth != null",
        "$quizId": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $profUid"
        }
      }
    },

    "professors": {
      ".indexOn": ["email"],
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "general_users": {
      ".indexOn": ["email"],
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "leaderboard": {
      ".indexOn": ["score", "timestamp", "department"],
      ".read": true,
      ".write": "auth != null"
    },

    "gameplay_data": {
      ".indexOn": ["studentId", "timestamp"],
      ".read": true,
      ".write": true
    },

  "student_career_stats": {
      ".indexOn": ["studentId"],
      ".read": true,
      ".write": true,
      "$studentId": {
        "studentInfo": { ".validate": "newData.hasChildren(['studentId', 'fullName'])" },
        "careerStats": { ".validate": "newData.hasChildren(['totalSessions', 'totalPoints'])" },
        "recentSessions": { ".validate": "newData.hasChildren()" }
      }
    },

    "system": {
      ".read": true,
      "maintenance": {
        ".read": true,
        ".write": "auth != null",
  ".validate": "newData.hasChildren(['enabled']) && newData.child('enabled').isBoolean()",
  "enabled": { ".validate": "newData.isBoolean()" },
        "message": { ".validate": "!newData.exists() || newData.isString()" },
        "startsAt": { ".validate": "!newData.exists() || newData.isString()" },
        "startsAtMs": { ".validate": "!newData.exists() || newData.isNumber()" },
        "startedAt": { ".validate": "!newData.exists() || newData.isString()" },
        "endsAt": { ".validate": "!newData.exists() || newData.isString()" },
        "endsAtMs": { ".validate": "!newData.exists() || newData.isNumber()" },
        "durationMinutes": { ".validate": "!newData.exists() || newData.isNumber()" },
        "updatedAt": { ".validate": "!newData.exists() || newData.isString()" }
      },
      "leaderboards": {
        ".read": true,
        "contest": {
          ".read": true,
          ".write": "auth != null",
          "startsAt": { ".validate": "!newData.exists() || newData.isString()" },
          "startsAtMs": { ".validate": "!newData.exists() || newData.isNumber()" },
          "endsAt": { ".validate": "!newData.exists() || newData.isString()" },
          "endsAtMs": { ".validate": "!newData.exists() || newData.isNumber()" },
          "header": { ".validate": "!newData.exists() || newData.isString()" },
          "description": { ".validate": "!newData.exists() || newData.isString()" },
          "visible": { ".validate": "!newData.exists() || newData.isBoolean()" },
          "updatedAt": { ".validate": "!newData.exists() || newData.isString()" }
        },
        "contestEnd": {
          ".read": true,
          ".write": "auth != null",
          "endsAt": { ".validate": "!newData.exists() || newData.isString()" },
          "endsAtMs": { ".validate": "!newData.exists() || newData.isNumber()" },
          "updatedAt": { ".validate": "!newData.exists() || newData.isString()" }
        }
      }
    },
    
    "feedbacks": {
      ".read": "auth != null && (root.child('roles/professors').child(auth.uid).val() === true || root.child('professors').child(auth.uid).val() != null)",
      "$entryId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['message','createdAt','senderUid','senderType']) && newData.child('message').isString() && newData.child('message').val().length > 0 && newData.child('message').val().length <= 2000 && newData.child('createdAt').isString() && newData.child('senderUid').isString() && newData.child('senderType').isString() && (newData.child('senderType').val() === 'student' || newData.child('senderType').val() === 'general')"
      }
    },
    
    "feedback_email_queue": {
      "$entryId": {
        ".write": "auth != null",
        ".read": false
      }
    },

    "story_progress": {
      ".indexOn": ["studentId"],
      ".read": "auth != null",
      ".write": "auth != null",
      "$studentId": {
        "noah": { ".validate": "newData.hasChildren(['chapter','scene','completed']) && newData.child('chapter').isNumber() && newData.child('scene').isNumber() && newData.child('completed').isBoolean()" },
        "lily": { ".validate": "newData.hasChildren(['chapter','scene','completed']) && newData.child('chapter').isNumber() && newData.child('scene').isNumber() && newData.child('completed').isBoolean()" },
        "damian": { ".validate": "newData.hasChildren(['chapter','scene','completed']) && newData.child('chapter').isNumber() && newData.child('scene').isNumber() && newData.child('completed').isBoolean()" }
      }
    },

    "mastery_aggregates": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['mastery','updatedAt'])",
        "mastery": {
          "$topic": {
            "$bloom": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
            }
          }
        },
        "updatedAt": { ".validate": "newData.isString()" }
      }
    },

    "password_resets": {
      "requests": {
        ".read": "auth != null && (root.child('roles/professors').child(auth.uid).val() === true || root.child('professors').child(auth.uid).val() != null)",
        "$requestId": {
          ".write": "auth != null && ( !data.exists() || root.child('roles/professors').child(auth.uid).val() === true || root.child('professors').child(auth.uid).val() != null )",
          ".validate": "newData.hasChildren(['studentId','createdAt','status']) && newData.child('studentId').isString() && newData.child('status').isString() && newData.child('createdAt').isString()"
        }
      },
      "approved": {
        ".read": false,
        "$studentId": {
          ".write": "auth != null && (root.child('roles/professors').child(auth.uid).val() === true || root.child('professors').child(auth.uid).val() != null || (data.val() === true && (!newData.exists() || newData.val() === false)))",
          ".validate": "!newData.exists() || newData.isBoolean()"
        }
      },
      "codes": {
        "$studentId": {
          ".read": "auth != null && (root.child('roles/professors').child(auth.uid).val() === true || root.child('professors').child(auth.uid).val() != null || root.child('password_resets/approved').child($studentId).val() === true)",
          ".write": "auth != null && (root.child('roles/professors').child(auth.uid).val() === true || root.child('professors').child(auth.uid).val() != null)",
          ".validate": "!newData.exists() || (newData.hasChildren(['codeHash','salt','iterations','issuedAt','expiresAt','used']) && !newData.child('rawCode').exists())"
        }
      },
      "history": {
        ".read": "auth != null && (root.child('roles/professors').child(auth.uid).val() === true || root.child('professors').child(auth.uid).val() != null)",
        "$entryId": {
          ".write": "auth != null && (root.child('roles/professors').child(auth.uid).val() === true || root.child('professors').child(auth.uid).val() != null)",
          ".validate": "newData.hasChildren(['studentId','issuedBy','issuedAt','expiresAt']) && newData.child('studentId').isString() && newData.child('issuedBy').isString() && newData.child('issuedAt').isString() && newData.child('expiresAt').isString()"
        }
      }
    }
  }
}
