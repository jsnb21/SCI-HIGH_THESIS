%% Main Gameplay Flow (MainGameplay scene)
%% Uses same theme as other diagrams; colored emphasis for key blocks
%% Background: white; Text: black; Borders/lines: dark gray

%%{init: {
  'theme': 'base',
  'themeVariables': {
    'background': '#ffffff',
    'textColor': '#000000',
    'primaryTextColor': '#000000',
    'edgeLabelBackground': '#ffffff',
    'lineColor': '#111111',
    'fontFamily': 'Inter, Segoe UI, Arial, Helvetica, sans-serif',
    'fontSize': '16px'
  },
  'flowchart': {
    'htmlLabels': false,
    'padding': 12,
    'nodeSpacing': 44,
    'rankSpacing': 56
  }
}}%%

flowchart TD
  %% Scene lifecycle
  S["Scene init\n(init)"] --> PL["Load assets\n(preload)"]
  PL --> CR["Setup board, player, enemies, HUD, timer\n(create)"]
  CR --> CD["Start countdown\n(3..1)"]
  CD --> GO["Start game\n(tick timer)"]

  %% Core loop branches
  GO --> MV{Input /\nMovement}
  MV -->|"Enemy tile"| QE["Launch QuizScene"]
  MV -->|"Timer icon"| AT["+5s time bonus"]
  MV -->|"Goblin thug"| TH["Time penalty\n-5s"]
  %% loop continues
  MV --> MV

  %% Quiz path
  QE --> QY{Correct?}
  QY -- "Yes" --> RW["Rewards:\n+Score, +Time,\nStreak +1"]
  QY -- "No" --> PN["Penalty:\n-10s, Streak reset"]
  RW --> PC{"Power-up cadence\n(5 correct)?"}
  PC -- "Yes" --> PU["Launch PowerUpScene"]
  PC -- "No" --> MV
  PN --> MV
  PU --> MV

  %% Timer and end conditions
  AT --> MV
  TH --> CK{Time <= 0?}
  CK -- "No" --> MV
  CK -- "Yes" --> TU["Time's Up\nOverlay"]
  TU --> RS["Result screen"]

  %% Intensity progression (simplified)
  RW --> IN["Check intensity\nprogression"]
  IN -->|"Reach LVL 3\nand 10 correct"| CC["Course completed"]
  IN -->|"Otherwise"| MV
  CC --> RS

  %% Styles
  classDef default fill:#ffffff,stroke:#111111,color:#000000,stroke-width:1.5px
  linkStyle default stroke:#111111,color:#000000,stroke-width:1.5px

  %% Emphasis classes (same palette family)
  classDef primary fill:#e6f0ff,stroke:#111111,color:#000000,stroke-width:1.5px
  classDef service fill:#e8f5e9,stroke:#111111,color:#000000,stroke-width:1.5px
  classDef danger fill:#ffe5e5,stroke:#111111,color:#000000,stroke-width:1.5px
  classDef outcome fill:#f3e8ff,stroke:#111111,color:#000000,stroke-width:1.5px

  %% Apply emphasis
  class S,PL,CR,GO primary
  class MV,QE,PU,IN service
  class TH,TU danger
  class RS,CC outcome
